---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Projects | Victor Solomon">
  <main class="light-page projects-page">
    <section class="light-hero split-hero">
      <div>
        <div class="light-kicker">Projects</div>
        <h1>Research systems, methods, and experiments.</h1>
      </div>

      <p>
        This page collects projects that are either published, under review, in development,
        or active research prototypes. Each entry will later link to a dedicated project page.
      </p>
    </section>

    <section class="light-section project-board">
      <article class="project-feature">
        <div class="project-status">active research</div>
        <h2>Progressive Multimodal Subspace Fusion</h2>
        <p>
          A staged fusion method for learning from heterogeneous modalities without forcing
          every view into a single uniform solution.
        </p>
        <div class="project-meta-line">
          <span>multimodal fusion</span>
          <span>representation learning</span>
          <span>brain research</span>
        </div>
        <a href="/#selected-work">View summary</a>
      </article>

      <div class="project-side-list">
        <article>
          <span>02</span>
          <h3>State aware structural dynamic fusion</h3>
          <p>
            Connecting stable structure with dynamic patterns in complex scientific systems.
          </p>
          <a href="/#selected-work">View summary</a>
        </article>

        <article>
          <span>03</span>
          <h3>Mutual information guided time series models</h3>
          <p>
            Learning temporal representations using dependence structure and flexible classifiers.
          </p>
          <a href="/#selected-work">View summary</a>
        </article>

        <article>
          <span>04</span>
          <h3>Foundation model project placeholder</h3>
          <p>
            Placeholder for a future project on scientific foundation models and multimodal adaptation.
          </p>
          <a href="#">Coming soon</a>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>