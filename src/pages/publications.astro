---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Publications | Victor Solomon">
  <main class="light-page publications-page">
    <section class="light-hero">
      <div class="light-kicker">Publications</div>
      <h1>Papers, preprints, and research outputs.</h1>
      <p>
        A structured list of publications. This page will be expanded with PDFs, code,
        BibTeX entries, project links, and short contribution summaries.
      </p>
    </section>

    <section class="light-section publication-layout">
      <aside class="publication-filters">
        <span>Categories</span>
        <a href="#">All</a>
        <a href="#">Multimodal learning</a>
        <a href="#">Scientific AI</a>
        <a href="#">Brain research</a>
        <a href="#">Time series</a>
      </aside>

      <div class="publication-timeline">
        <article class="publication-entry">
          <div class="pub-year">2026</div>
          <div>
            <h2>Progressive Multimodal Subspace Fusion</h2>
            <p>
              Placeholder entry for PMSF related publication details, authors, venue,
              paper link, code link, and contribution summary.
            </p>
            <div class="pub-links">
              <a href="#">PDF</a>
              <a href="#">Code</a>
              <a href="#">BibTeX</a>
            </div>
          </div>
        </article>

        <article class="publication-entry">
          <div class="pub-year">2025</div>
          <div>
            <h2>Selected publication placeholder</h2>
            <p>
              Add title, authors, venue, DOI, PDF, code, and a one sentence summary
              of the paper contribution.
            </p>
            <div class="pub-links">
              <a href="#">PDF</a>
              <a href="#">Code</a>
              <a href="#">BibTeX</a>
            </div>
          </div>
        </article>

        <article class="publication-entry muted-entry">
          <div class="pub-year">Soon</div>
          <div>
            <h2>Under review and in preparation</h2>
            <p>
              Placeholder for manuscripts under review, preprints, and papers in preparation.
            </p>
          </div>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>