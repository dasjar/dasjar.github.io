---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Notes | Victor Solomon">
  <main class="light-page notes-page">
    <section class="light-hero split-hero">
      <div>
        <div class="light-kicker">Notes</div>
        <h1>Technical notes and research logs.</h1>
      </div>

      <p>
        Public notes will include polished research notes, paper summaries, implementation
        reflections, and cleaned project logs. Private advisor notes should stay private.
      </p>
    </section>

    <section class="light-section notes-grid">
      <article class="note-card large-note">
        <span>Research log</span>
        <h2>What I am building now</h2>
        <p>
          Placeholder for a short public update about current experiments, methods,
          and research directions.
        </p>
        <a href="#">Coming soon</a>
      </article>

      <article class="note-card">
        <span>Paper notes</span>
        <h2>Multimodal learning reading list</h2>
        <p>
          Placeholder for summaries of papers on multimodal fusion, representation learning,
          and scientific AI.
        </p>
        <a href="#">Coming soon</a>
      </article>

      <article class="note-card">
        <span>Methods</span>
        <h2>IVA and multimodal fusion</h2>
        <p>
          Placeholder for a clean explanation of independent vector analysis and how it
          supports multimodal fusion.
        </p>
        <a href="#">Coming soon</a>
      </article>

      <article class="note-card">
        <span>Private workflow</span>
        <h2>Advisor notes</h2>
        <p>
          Private advisor meeting notes should not be published here. This section can
          contain sanitized summaries only.
        </p>
        <a href="#">Private</a>
      </article>
    </section>
  </main>
</BaseLayout>