---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile, news, publications } from "../data/profile";

const featuredPublications = publications;
---

<BaseLayout title="Victor Solomon | Scientific Machine Learning">
  <main class="site-main home-page">
    <section class="intro-section" id="about">
      <div class="intro-copy">
        <h1>{profile.name}</h1>

        <p class="identity-line">
          <span>{profile.affiliation}</span> {profile.role}
        </p>

        {profile.summary.map((paragraph) => (
          <p>{paragraph}</p>
        ))}

        <p>
          Feel free to reach me at:
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </p>

        <div class="intro-actions">
          <a href="#publications">publications</a>
          <a href={profile.cv} target="_blank" rel="noreferrer">CV</a>
        </div>
      </div>

      <aside class="portrait-wrap">
        <img src={profile.photo} alt="Victor Solomon profile photo" width="290" height="290" loading="eager" decoding="async" fetchpriority="high" />
      </aside>
    </section>

    <section class="content-section">
      <h2>news</h2>

      <div class="news-list">
        {news.map((item) => (
          <article class="news-item">
            <time>{item.date}</time>
            <p>
              {item.text}
            </p>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section" id="publications">
      <div class="section-title-row">
        <h2>selected publications</h2>
      </div>

      <div class="publication-list compact">
        {featuredPublications.map((pub) => (
          <article class="publication-card">
            <div class={`pub-thumb pub-thumb-${pub.placeholder.toLowerCase().replace(/\s+/g, "-")}`}>
              {pub.image ? (
                <img src={pub.image} alt={`${pub.title} thumbnail`} />
              ) : (
                <span>{pub.placeholder}</span>
              )}
            </div>

            <div class="pub-body">
              <h3>{pub.title}</h3>
              <p class="pub-authors">{pub.authors}</p>
              <p class="pub-venue">{pub.venue}, {pub.year}</p>

              <div class="link-row">
                {pub.links.map((link) => (
                  <a href={link.url} target={link.url.startsWith("http") ? "_blank" : "_self"} rel="noreferrer">{link.label}</a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

                    <section class="contact-strip" aria-label="Contact links">
      <a href={profile.cv} target="_blank" rel="noreferrer" aria-label="CV" title="CV" class="contact-logo cv-logo">
        <span>CV</span>
      </a>

      <a href={`mailto:${profile.email}`} aria-label="Email" title="Email" class="contact-logo">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect x="8" y="16" width="48" height="34" rx="3"></rect>
          <path d="M10 18 32 36 54 18"></path>
        </svg>
      </a>

      <a href={profile.scholar} target="_blank" rel="noreferrer" aria-label="Google Scholar" title="Google Scholar" class="contact-logo scholar-logo">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <text x="13" y="45" font-size="44" font-family="Georgia, Times New Roman, serif" font-weight="500">g</text>
          <path d="M39 16 58 26 39 36 20 26 39 16Z"></path>
          <path d="M47 32v9"></path>
          <circle cx="47" cy="45" r="2.2"></circle>
        </svg>
      </a>

      <a href={profile.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn" class="contact-logo linkedin-logo">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect x="9" y="9" width="46" height="46" rx="4"></rect>
          <rect x="18" y="26" width="7" height="21"></rect>
          <circle cx="21.5" cy="19" r="4"></circle>
          <path d="M32 26h7v3.1c1.1-1.9 3.5-3.8 7.1-3.8 6.1 0 7.2 4 7.2 9.4V47h-7V36.1c0-2.6 0-5.9-3.6-5.9-3.7 0-4.2 2.8-4.2 5.7V47H32Z"></path>
        </svg>
      </a>

      <a href={profile.github} target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub" class="contact-logo github-logo">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M32 7.5a24.5 24.5 0 0 0-7.7 47.8c1.2.2 1.6-.5 1.6-1.1v-4.4c-6.7 1.5-8.1-2.9-8.1-2.9-1.1-2.8-2.7-3.5-2.7-3.5-2.2-1.5.2-1.5.2-1.5 2.4.2 3.7 2.5 3.7 2.5 2.2 3.7 5.7 2.6 7.1 2 .2-1.6.8-2.6 1.5-3.2-5.3-.6-10.9-2.7-10.9-11.9 0-2.6.9-4.8 2.5-6.5-.3-.6-1.1-3.1.2-6.4 0 0 2-.7 6.7 2.5a23.3 23.3 0 0 1 12.2 0c4.7-3.2 6.7-2.5 6.7-2.5 1.3 3.3.5 5.8.2 6.4 1.6 1.7 2.5 3.9 2.5 6.5 0 9.3-5.6 11.3-11 11.9.9.8 1.7 2.3 1.7 4.6v6.8c0 .6.4 1.4 1.7 1.1A24.5 24.5 0 0 0 32 7.5Z"></path>
        </svg>
      </a>

      <a href={profile.researchGate} target="_blank" rel="noreferrer" aria-label="ResearchGate" title="ResearchGate" class="contact-logo rg-logo">
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <rect x="7" y="7" width="50" height="50" rx="3"></rect>
          <text x="13" y="43" font-size="34" font-family="Georgia, Times New Roman, serif" font-weight="600">R</text>
          <text x="38" y="24" font-size="19" font-family="Georgia, Times New Roman, serif" font-weight="700">G</text>
        </svg>
      </a>

      <p>{profile.contactLine}</p>
    </section>
  </main>
</BaseLayout>