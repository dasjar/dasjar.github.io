---
import "../styles/global.css";
import { profile } from "../data/profile";

const {
  title = "Victor Solomon",
  description = "Victor Solomon, Ph.D. Candidate in Computer Science at Georgia State University."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>

  <body>
    <header class="topbar">
      <nav class="nav-shell" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="Victor Solomon home">VS</a>

        <div class="nav-links">
          <a href="/">about</a>
          <a href={profile.cv} target="_blank" rel="noreferrer">CV</a>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="footer">
      <div class="footer-inner">
        <p>© 2026 Victor Solomon. Built with Astro and hosted on GitHub Pages.</p>
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </footer>
  </body>
</html>